# ---- Server ----
PORT=4000
# Comma-separated list of allowed frontend origins ("*" allows all)
CORS_ORIGIN=http://localhost:5173

# ---- Database (Supabase -> Project Settings -> Database -> Connection string, "Session pooler") ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/price_tracker
# Set to true for Supabase / any hosted Postgres
DATABASE_SSL=false

# ---- Scheduler ----
# cron-job.org sends this in the "x-cron-secret" header. Use a long random string.
CRON_SECRET=change-me
# How many due products one scheduler call may check (keeps memory/time bounded on Render free tier)
MAX_CHECKS_PER_RUN=10
# Local development only: built-in timer that runs due checks every N minutes (default 1 when
# NODE_ENV is not "production"; always off on Render). 0 = off, rely on the cron URL instead.
# LOCAL_SCHEDULER_MINUTES=1
# Default check interval for newly tracked products (minutes)
DEFAULT_CHECK_INTERVAL_MINUTES=120

# ---- Store / scraper ----
STORE_BASE_URL=https://demo.inelabteamdev.com
# false = open a visible browser window ("headed mode"), only works on a machine with a screen
SCRAPER_HEADLESS=true
# Milliseconds Playwright waits between actions (use ~250 in headed mode so humans can follow)
SCRAPER_SLOW_MO=0
# Full page-level attempts per check (the store page itself also retries the price API up to 6 times)
SCRAPER_MAX_ATTEMPTS=3
# Optional: path to a Chromium binary if Playwright's bundled one isn't installed
# CHROMIUM_PATH=
